{
  "name": "sekirei-action",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/main.cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "@actions/core": "3.0.1", "zod": "4.6.7" },
  "devDependencies": { "@types/node": "^24.0.0", "esbuild": "0.28.2", "typescript": "7.0.2", "tsx": "^4.0.0", "yaml": "^2.0.0" }
}
